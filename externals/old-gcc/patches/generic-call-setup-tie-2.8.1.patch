+/* Reject special effects and register fragments in both call-role queries.  */
+static rtx
+sched_call_tie_dest (insn)
+     rtx insn;
+{
+  rtx pat, dest, next;
+  if (GET_CODE (insn) != INSN || SCHED_GROUP_P (insn)
+      || RTX_FRAME_RELATED_P (insn) || recog_memoized (insn) < 0)
+    return 0;
