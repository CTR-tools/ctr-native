+/* Only ordinary integer arithmetic and complete register/constant leaves.  */
+static int
+sched_pure_integer_expr (x)
+     rtx x;
+{
+  char cls = GET_RTX_CLASS (GET_CODE (x));
+  if (GET_CODE (x) == CONST_INT)
+    return 1;
+  if (GET_CODE (x) == REG)
+    return (GET_MODE_CLASS (GET_MODE (x)) == MODE_INT
+            && REGNO (x) < FIRST_PSEUDO_REGISTER
+            && HARD_REGNO_NREGS (REGNO (x), GET_MODE (x)) == 1);
+  if (GET_MODE_CLASS (GET_MODE (x)) != MODE_INT)
+    return 0;
+  if (cls == '1')
+    return sched_pure_integer_expr (XEXP (x, 0));
+  if (cls == '2' || cls == 'c')
+    return (sched_pure_integer_expr (XEXP (x, 0))
+            && sched_pure_integer_expr (XEXP (x, 1)));
+  return 0;
 }
 
