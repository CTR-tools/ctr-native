+  if (next && GET_CODE (next) != CODE_LABEL && SCHED_GROUP_P (next))
+    return 0;
+  pat = PATTERN (insn);
+  if (GET_CODE (pat) != SET || GET_CODE (SET_DEST (pat)) != REG)
+    return 0;
+  dest = SET_DEST (pat);
+  if (GET_MODE_CLASS (GET_MODE (dest)) != MODE_INT
+      || REGNO (dest) >= FIRST_PSEUDO_REGISTER
+      || fixed_regs[REGNO (dest)] || global_regs[REGNO (dest)]
+      || HARD_REGNO_NREGS (REGNO (dest), GET_MODE (dest)) != 1)
+    return 0;
+  return dest;
