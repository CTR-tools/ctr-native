+{
+  rtx insn, pat, slot, branch, dest;
+  int i;
+  if (!TARGET_PSX_PREBRANCH_LW_DELAY) return;
+  for (insn = get_insns (); insn; insn = NEXT_INSN (insn))
+    if (GET_CODE (insn) == INSN && GET_CODE (PATTERN (insn)) == SEQUENCE)
+      {
