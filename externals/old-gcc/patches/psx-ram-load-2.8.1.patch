+/* Duplicate only a recognized compiler-owned fixed void epilogue, after
+   final jump merging and before delay-slot resource tables are built.  */
+static int
+mips_clone_opaque_p (x)
+     rtx x;
+{
+  const char *fmt;
+  int i, j;
+  if (x == 0)
+    return 0;
+  if (GET_CODE (x) == ASM_OPERANDS)
+    {
+      /* Field 4 is constraint metadata, not an operand expression.  */
+      if (ASM_OPERANDS_TEMPLATE (x)[0] != 0)
+        return 1;
+      if (ASM_OPERANDS_INPUT_VEC (x) != 0)
+        for (i = 0; i < ASM_OPERANDS_INPUT_LENGTH (x); ++i)
+          if (mips_clone_opaque_p (ASM_OPERANDS_INPUT (x, i)))
+            return 1;
+      return 0;
+    }
+  if (GET_CODE (x) == UNSPEC || GET_CODE (x) == UNSPEC_VOLATILE
+      || GET_CODE (x) == ASM_INPUT)
+    return 1;
+  fmt = GET_RTX_FORMAT (GET_CODE (x));
+  for (i = 0; i < GET_RTX_LENGTH (GET_CODE (x)); ++i)
+    if (fmt[i] == 'e')
+      {
+        if (mips_clone_opaque_p (XEXP (x, i)))
+          return 1;
+      }
+    else if (fmt[i] == 'E' && XVEC (x, i) != 0)
+      for (j = 0; j < XVECLEN (x, i); ++j)
+        if (mips_clone_opaque_p (XVECEXP (x, i, j)))
+          return 1;
+  return 0;
+}
