+/* Literal emitting ALU only: no self-move, USE, hidden resource or ASM. */
+static int
+mips_pblw_alu_p (insn)
+     rtx insn;
+{
+  rtx pat, src, x;
+  enum rtx_code code;
+  int i;
+  if (!insn || GET_CODE (insn) != INSN || INSN_DELETED_P (insn)
+      || recog_memoized (insn) < 0 || get_attr_length (insn) != 1
+      || get_attr_type (insn) != TYPE_ARITH)
+    return 0;
+  pat = PATTERN (insn);
+  if (GET_CODE (pat) != SET || !mips_pblw_gpr_p (SET_DEST (pat)))
+    return 0;
+  src = SET_SRC (pat), code = GET_CODE (src);
+  if (code != AND && code != IOR && code != XOR && code != PLUS && code != MINUS
+      && code != ASHIFT && code != ASHIFTRT && code != LSHIFTRT)
+    return 0;
+  for (i = 0; i < 2; i++)
+    {
+      x = XEXP (src, i);
+      if (GET_CODE (x) != CONST_INT && !mips_pblw_gpr_p (x))
+        return 0;
+    }
+  return 1;
