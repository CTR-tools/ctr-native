+                && NEXT_INSN (branch) == slot && PREV_INSN (slot) == branch
+                && NEXT_INSN (slot) == NEXT_INSN (insn)
+                && mips_pblw_removal_p (insn)
+                && mips_pblw_gap_p (NEXT_INSN (insn), dest)
+                && mips_pblw_gap_p (JUMP_LABEL (branch), dest))
+              continue;
+            debug_rtx (insn);
+            fatal ("PSX prebranch normal-RAM LW invariant failed");
+          }
+      }
