+/* Default-off ordinary mapped-RAM LW: adjacent backward motion, or first
+   fallthrough speculation in the certified stable, fully mapped RAM domain.
+   No fault/BD/EPC/IRQ equivalence or MMIO permission is implied. */
+static int
+mips_pblw_gpr_p (x)
+     rtx x;
+{
+  return (GET_CODE (x) == REG && GET_MODE (x) == SImode
+          && GP_REG_P (REGNO (x)) && REGNO (x) >= 2
+          && (REGNO (x) < 26 || REGNO (x) >= 29));
+}
+
+static int
+mips_pblw_mem_p (mem, mode)
+     rtx mem;
+     enum machine_mode mode;
+{
+  rtx addr;
+  HOST_WIDE_INT off = 0;
+  if (GET_CODE (mem) != MEM || GET_MODE (mem) != mode
+      || MEM_VOLATILE_P (mem) || RTX_UNCHANGING_P (mem))
+    return 0;
+  addr = XEXP (mem, 0);
+  if (GET_CODE (addr) == PLUS && GET_MODE (addr) == SImode
+      && GET_CODE (XEXP (addr, 1)) == CONST_INT)
+    off = INTVAL (XEXP (addr, 1)), addr = XEXP (addr, 0);
+  return (mips_pblw_gpr_p (addr) && off >= -32768 && off <= 32767
+          && off % GET_MODE_SIZE (mode) == 0);
+}
+
+static rtx
+mips_pblw_dest (slot)
+     rtx slot;
+{
+  rtx pat, dest, src;
+  int code;
+  if (!slot || GET_CODE (slot) != INSN || INSN_DELETED_P (slot)
+      || ((code = recog_memoized (slot)) != CODE_FOR_movsi_internal2
+          && code != CODE_FOR_extendhisi2_internal)
+      || get_attr_type (slot) != TYPE_LOAD || get_attr_length (slot) != 1)
+    return 0;
+  pat = PATTERN (slot);
+  if (GET_CODE (pat) != SET || !mips_pblw_gpr_p (SET_DEST (pat)))
+    return 0;
+  dest = SET_DEST (pat);
+  src = SET_SRC (pat);
+  if (REGNO (dest) >= 26 || fixed_regs[REGNO (dest)]
+      || global_regs[REGNO (dest)]
+      || !((code == CODE_FOR_movsi_internal2
+            && mips_pblw_mem_p (src, SImode))
+           || (code == CODE_FOR_extendhisi2_internal
+               && GET_CODE (src) == SIGN_EXTEND && GET_MODE (src) == SImode
+               && mips_pblw_mem_p (XEXP (src, 0), HImode)))
+      || reg_overlap_mentioned_p (dest, src))
+    return 0;
+  return dest;
+}
