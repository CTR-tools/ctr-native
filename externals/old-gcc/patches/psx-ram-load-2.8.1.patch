+/* One real ALU protects the earlier GPR result needed by this branch.
+   An unannulled branch's physical ALU slot is the same fallthrough gap. */
+static int
+mips_pblw_removal_p (insn)
+     rtx insn;
+{
+  rtx prev, seq, branch, slot, pat, cond, target, marker = 0;
+  for (;;)
+    {
+      do
+        {
+          prev = PREV_INSN (insn);
+          if (!prev || NEXT_INSN (prev) != insn)
+            return 0;
+          insn = prev;
+        }
+      while (GET_CODE (insn) == NOTE);
+      if (GET_CODE (insn) != INSN || GET_CODE (PATTERN (insn)) != USE)
+        break;
+      /* One administrative marker, never an instruction-gap witness.
+         Its payload must be the exact live SEQUENCE tail checked below. */
+      if (marker || INSN_DELETED_P (insn)
+          || GET_MODE (PATTERN (insn)) != VOIDmode)
+        return 0;
+      marker = insn;
+    }
+  if (!marker && mips_pblw_alu_p (insn))
+    return 1;
+  if (GET_CODE (insn) != INSN || INSN_DELETED_P (insn)
+      || GET_CODE (PATTERN (insn)) != SEQUENCE
+      || XVECLEN (PATTERN (insn), 0) != 2)
+    return 0;
+  seq = PATTERN (insn);
+  branch = XVECEXP (seq, 0, 0);
+  slot = XVECEXP (seq, 0, 1);
+  if (GET_CODE (branch) != JUMP_INSN || INSN_DELETED_P (branch)
+      || INSN_ANNULLED_BRANCH_P (branch) || recog_memoized (branch) < 0
+      || get_attr_type (branch) != TYPE_BRANCH
+      || get_attr_length (branch) != 1 || !JUMP_LABEL (branch)
+      || (marker && XEXP (PATTERN (marker), 0) != slot)
+      || !mips_pblw_alu_p (slot)
+      || PREV_INSN (branch) != PREV_INSN (insn)
+      || NEXT_INSN (branch) != slot || PREV_INSN (slot) != branch
+      || NEXT_INSN (slot) != NEXT_INSN (insn))
+    return 0;
+  pat = PATTERN (branch);
+  if (GET_CODE (pat) != SET || SET_DEST (pat) != pc_rtx
+      || GET_CODE (SET_SRC (pat)) != IF_THEN_ELSE)
+    return 0;
+  pat = SET_SRC (pat);
+  cond = XEXP (pat, 0);
+  if ((GET_CODE (cond) != EQ && GET_CODE (cond) != NE
+       && GET_CODE (cond) != GT)
+      || GET_MODE (cond) != SImode || !mips_pblw_gpr_p (XEXP (cond, 0))
+      || XEXP (cond, 1) != const0_rtx
+      || (XEXP (pat, 1) != pc_rtx && XEXP (pat, 2) != pc_rtx))
+    return 0;
+  target = XEXP (pat, 1) == pc_rtx ? XEXP (pat, 2) : XEXP (pat, 1);
+  return (GET_CODE (target) == LABEL_REF
+          && XEXP (target, 0) == JUMP_LABEL (branch));
+}
+
+/* The first physical successor must neither read nor overwrite the entire
+   pending GPR.  Signed LH and SP-based RA LW are real, encoded witnesses. */
+static int
+mips_pblw_gap_p (insn, dest)
+     rtx insn, dest;
+{
+  rtx pat, src;
+  while (insn && (GET_CODE (insn) == NOTE || GET_CODE (insn) == CODE_LABEL))
+    insn = NEXT_INSN (insn);
+  if (!insn || (GET_CODE (insn) != INSN && GET_CODE (insn) != JUMP_INSN)
+      || INSN_DELETED_P (insn) || recog_memoized (insn) < 0
+      || get_attr_length (insn) != 1
+      || reg_overlap_mentioned_p (dest, PATTERN (insn)) || reg_set_p (dest, insn))
+    return 0;
+  if (mips_pblw_alu_p (insn))
+    return 1;
+  pat = PATTERN (insn);
+  if (GET_CODE (insn) == JUMP_INSN && GET_CODE (pat) == RETURN)
+    return 1; /* Pending output never RA. */
+  if (GET_CODE (insn) != INSN || GET_CODE (pat) != SET
+      || !mips_pblw_gpr_p (SET_DEST (pat)) || get_attr_type (insn) != TYPE_LOAD)
+    return 0;
+  src = SET_SRC (pat);
+  return ((recog_memoized (insn) == CODE_FOR_movsi_internal2
+           && mips_pblw_mem_p (src, SImode))
+          || (recog_memoized (insn) == CODE_FOR_extendhisi2_internal
+              && GET_CODE (src) == SIGN_EXTEND
+              && mips_pblw_mem_p (XEXP (src, 0), HImode)));
+}
+
+static int
+mips_pblw_branch_p (branch, slot)
+     rtx branch, slot;
+{
+  rtx pat, src, cond, target, dest = mips_pblw_dest (slot);
+  if (!dest || !branch || GET_CODE (branch) != JUMP_INSN
+      || INSN_DELETED_P (branch) || INSN_ANNULLED_BRANCH_P (branch)
+      || recog_memoized (branch) < 0 || get_attr_type (branch) != TYPE_BRANCH
+      || get_attr_length (branch) != 1 || !JUMP_LABEL (branch))
+    return 0;
+  pat = PATTERN (branch);
+  if (GET_CODE (pat) != SET || SET_DEST (pat) != pc_rtx
+      || GET_CODE (SET_SRC (pat)) != IF_THEN_ELSE)
+    return 0;
+  src = SET_SRC (pat), cond = XEXP (src, 0);
+  if ((GET_CODE (cond) != GT && GET_CODE (cond) != NE)
+      || GET_MODE (cond) != SImode || !mips_pblw_gpr_p (XEXP (cond, 0))
+      || XEXP (cond, 1) != const0_rtx
+      || (recog_memoized (slot) != CODE_FOR_movsi_internal2
+          && REGNO (XEXP (cond, 0)) == REGNO (dest))
+      || (XEXP (src, 1) != pc_rtx && XEXP (src, 2) != pc_rtx))
+    return 0;
+  target = XEXP (src, 1) == pc_rtx ? XEXP (src, 2) : XEXP (src, 1);
+  return (GET_CODE (target) == LABEL_REF
+          && XEXP (target, 0) == JUMP_LABEL (branch));
+}
+
+int
+mips_prebranch_lw_slot_p (slot)
+     rtx slot;
+{
+  rtx pat, src;
+  if (!TARGET_PSX_PREBRANCH_LW_DELAY || !slot || GET_CODE (slot) != INSN)
+    return 0;
+  pat = PATTERN (slot);
+  if (GET_CODE (pat) != SET)
+    return 0;
+  src = SET_SRC (pat);
+  /* Keep shape classification broad enough to validate an invalidated
+     installed signed-LH slot rather than silently ignoring it. */
+  return ((GET_CODE (src) == MEM && GET_MODE (src) == SImode
+           && !MEM_VOLATILE_P (src))
+          || (GET_CODE (src) == SIGN_EXTEND && GET_MODE (src) == SImode
+              && GET_CODE (XEXP (src, 0)) == MEM
+              && GET_MODE (XEXP (src, 0)) == HImode
+              && !MEM_VOLATILE_P (XEXP (src, 0))));
+}
+
+static int
+mips_pblw_delay_p (branch, slot, forward)
+     rtx branch, slot;
+     int forward;
+{
+  rtx prev, next, dest, cond;
+  if (!TARGET_PSX_PREBRANCH_LW_DELAY || mips_isa != 1 || TARGET_64BIT
+      || TARGET_BIG_ENDIAN || mips_abi != ABI_32 || INT_TYPE_SIZE != 32
+      || !reload_completed
+      || !mips_pblw_branch_p (branch, slot))
+    return 0;
+  prev = PREV_INSN (branch);
+  if (!prev || NEXT_INSN (prev) != branch)
+    return 0;
+  dest = mips_pblw_dest (slot);
+  if (forward)
+    {
+      /* Forward speculation is certified only for SI, not signed LH. */
+      if (recog_memoized (slot) != CODE_FOR_movsi_internal2)
+        return 0;
+      next = branch;
+      do
+        {
+          prev = next;
+          next = NEXT_INSN (next);
+          if (!next || PREV_INSN (next) != prev)
+            return 0;
+        }
+      while (GET_CODE (next) == NOTE);
+      return (next == slot && mips_pblw_removal_p (branch)
+              && mips_pblw_gap_p (NEXT_INSN (slot), dest)
+              && mips_pblw_gap_p (JUMP_LABEL (branch), dest));
+    }
+  while (GET_CODE (prev) == NOTE)
+    {
+      next = prev;
+      prev = PREV_INSN (prev);
+      if (!prev || NEXT_INSN (prev) != next)
+        return 0;
+    }
+  cond = XEXP (SET_SRC (PATTERN (branch)), 0);
+  return (prev == slot && REGNO (XEXP (cond, 0)) != REGNO (dest)
+          && mips_pblw_removal_p (slot)
+          && mips_pblw_gap_p (NEXT_INSN (branch), dest)
+          && mips_pblw_gap_p (JUMP_LABEL (branch), dest));
+}
+
+int
+mips_prebranch_lw_delay_p (branch, slot)
+     rtx branch, slot;
+{
+  return (mips_pblw_delay_p (branch, slot, 0)
+          || mips_pblw_delay_p (branch, slot, 1));
+}
+
+/* Only reorg's owned first-fallthrough gate may use this RAM certificate.
+   Opposite-path liveness remains a separate mandatory generic check. */
+int
+mips_first_fallthrough_lw_p (branch, slot)
+     rtx branch, slot;
+{
+  return mips_pblw_delay_p (branch, slot, 1);
+}
