+     rtx insn;
+{
+  rtx set, dest, src;
+  if (!mips_preserve_small_si_constants || !reload_completed || mips_isa != 1
+      || TARGET_64BIT || mips_abi != ABI_32 || INT_TYPE_SIZE != 32
+      || GET_CODE (insn) != INSN || RTX_FRAME_RELATED_P (insn))
+    return 0;
+  set = PATTERN (insn);
+  if (GET_CODE (set) != SET
+      || recog_memoized (insn) != CODE_FOR_movsi_internal2
+      || get_attr_length (insn) != 1)
+    return 0;
+  dest = SET_DEST (set);
+  src = SET_SRC (set);
+  return GET_CODE (dest) == REG && GET_MODE (dest) == SImode
+    && REGNO (dest) >= 2 && REGNO (dest) <= 25 && !fixed_regs[REGNO (dest)]
+    && GET_CODE (src) == CONST_INT && INTVAL (src) != 0
+    && INTVAL (src) >= -32768 && INTVAL (src) <= 32767;
+}
