 /* Next quantity number available for allocation.  */
 
 static int next_qty;
+static short *local_reg_hints;
+
+/* Soft, declaration-local preferences never create hard-register RTL.  */
+int
+local_register_hint_value (decl, args)
+     tree decl, args;
+{
+  tree value = args ? TREE_VALUE (args) : 0;
+  int regno;
+  enum machine_mode mode;
+  if (!decl || TREE_CODE (decl) != VAR_DECL || !current_function_decl
+      || TREE_STATIC (decl) || DECL_EXTERNAL (decl)
+      || TREE_THIS_VOLATILE (decl)
+      || (!INTEGRAL_TYPE_P (TREE_TYPE (decl))
+          && !POINTER_TYPE_P (TREE_TYPE (decl)))
+      || !value || TREE_CHAIN (args) || TREE_CODE (value) != STRING_CST)
+    goto invalid;
+  mode = TYPE_MODE (TREE_TYPE (decl));
+  regno = decode_reg_name (TREE_STRING_POINTER (value));
+  if (regno < 0 || regno >= FIRST_PSEUDO_REGISTER || fixed_regs[regno]
+      || global_regs[regno] || regno == FRAME_POINTER_REGNUM
+      || regno == ARG_POINTER_REGNUM || !HARD_REGNO_MODE_OK (regno, mode)
+      || HARD_REGNO_NREGS (regno, mode) != 1
+      || GET_MODE_SIZE (mode) > UNITS_PER_WORD
+      || !TEST_HARD_REG_BIT (reg_class_contents[(int) GENERAL_REGS], regno))
+    goto invalid;
+  return regno + 1;
+invalid:
+  error ("local_register_hint requires an automatic scalar/pointer and a valid nonfixed single-word register");
+  return 0;
+}
+
+static void
+collect_local_register_hints (block)
+     tree block;
+{
+  tree decl, sub, attribute;
+  rtx reg;
+  if (!block || TREE_CODE (block) != BLOCK)
+    return;
+  for (decl = BLOCK_VARS (block); decl; decl = TREE_CHAIN (decl))
+    if (TREE_CODE (decl) == VAR_DECL
+        && (attribute = lookup_attribute ("local_register_hint",
+                                         DECL_MACHINE_ATTRIBUTES (decl))))
+      {
+        reg = DECL_RTL (decl);
+        if (!reg || GET_CODE (reg) != REG || REGNO (reg) < FIRST_PSEUDO_REGISTER)
+          error ("local_register_hint cannot apply to memory or hard-asm variables");
+        else if (REGNO (reg) < max_regno && REG_N_REFS (REGNO (reg)))
+          {
+            if (!local_reg_hints)
+              {
+                local_reg_hints = (short *) xmalloc (max_regno * sizeof (short));
+                bzero ((char *) local_reg_hints, max_regno * sizeof (short));
+              }
+            local_reg_hints[REGNO (reg)]
+              = local_register_hint_value (decl, TREE_VALUE (attribute));
+          }
+      }
+  for (sub = BLOCK_SUBBLOCKS (block); sub; sub = TREE_CHAIN (sub))
+    collect_local_register_hints (sub);
+}
 
