+/* Sched2-only, entry-prefix subset of stack/argument base-origin analysis.
+   It does not infer through pointer loads, copies, arbitrary expressions,
+   calls, ASM, frame exposure or control flow.  Existing non-memory edges,
+   barriers, unwind notes and all other alias predicates remain unchanged. */
+int
+mips_prologue_arg_read_disjoint_p (save, mem, insn, read_mem)
+     rtx save, mem, insn, read_mem;
+{
+  rtx addr, base, set, p, src, allocation = NULL_RTX;
+  tree arg;
+  int regno, allocated = 0, saved = 0, prologue_end = 0;
+  int allocation_boundary = 0;
+  if (!mips_prologue_arg_alias || !reload_completed || TARGET_64BIT
+      || TARGET_ABICALLS || TARGET_EMBEDDED_PIC || mips_abi != ABI_32
+      || UNITS_PER_WORD != 4 || frame_pointer_needed || profile_flag
+      || flag_exceptions || asynchronous_exceptions
+      || current_function_calls_alloca || current_function_calls_setjmp
+      || current_function_calls_longjmp || current_function_has_nonlocal_label
+      || current_function_has_nonlocal_goto || current_function_contains_functions
+      || current_function_needs_context || current_function_varargs
+      || current_function_stdarg || current_function_returns_struct
+      || !current_frame_info.initialized || current_frame_info.total_size <= 0
+      || current_frame_info.total_size > 32767
+      || !mips_new_frame_gpr_save_p (save, mem)
+      || GET_CODE (insn) != INSN || GET_CODE (read_mem) != MEM
+      || GET_MODE (read_mem) != SImode || MEM_VOLATILE_P (read_mem)
+      || (set = single_set (insn)) == 0 || SET_SRC (set) != read_mem
+      || GET_CODE (SET_DEST (set)) != REG)
+    return 0;
+  addr = XEXP (read_mem, 0);
+  if (GET_CODE (addr) == PLUS)
+    {
+      if (GET_CODE (XEXP (addr, 1)) != CONST_INT)
+        return 0;
+      addr = XEXP (addr, 0);
+    }
+  if (GET_CODE (addr) != REG || GET_MODE (addr) != Pmode)
+    return 0;
+  base = addr;
+  regno = REGNO (base);
+  if (regno < GP_ARG_FIRST || regno > GP_ARG_FIRST + 3 || global_regs[regno])
+    return 0;
+  for (arg = DECL_ARGUMENTS (current_function_decl); arg; arg = TREE_CHAIN (arg))
+    if (TREE_CODE (TREE_TYPE (arg)) == POINTER_TYPE
+        && DECL_INCOMING_RTL (arg) != 0
+        && GET_CODE (DECL_INCOMING_RTL (arg)) == REG
+        && GET_MODE (DECL_INCOMING_RTL (arg)) == Pmode
+        && REGNO (DECL_INCOMING_RTL (arg)) == regno)
+      break;
+  if (arg == 0)
+    return 0;
+  for (p = get_insns (); p && p != insn; p = NEXT_INSN (p))
+    {
+      if (GET_CODE (p) == NOTE)
+        {
+          if (NOTE_LINE_NUMBER (p) == NOTE_INSN_PROLOGUE_END)
+            prologue_end = 1;
+          else if (NOTE_LINE_NUMBER (p) == NOTE_INSN_EPILOGUE_BEG
+                   || NOTE_LINE_NUMBER (p) == NOTE_INSN_EH_REGION_BEG
+                   || NOTE_LINE_NUMBER (p) == NOTE_INSN_EH_REGION_END)
+            return 0;
+          continue;
+        }
+      /* Only the backend's boundary immediately after this real allocation.
+         This scan exception does not remove its scheduler dependencies. */
+      if (GET_CODE (p) == INSN && allocated && !saved && !prologue_end
+          && !allocation_boundary && prev_nonnote_insn (p) == allocation
+          && GET_CODE (PATTERN (p)) == UNSPEC_VOLATILE
+          && XINT (PATTERN (p), 1) == 0 && XVECLEN (PATTERN (p), 0) == 1
+          && XVECEXP (PATTERN (p), 0, 0) == const0_rtx
+          && recog_memoized (p) == CODE_FOR_blockage)
+        {
+          allocation_boundary = 1;
+          continue;
+        }
+      if (GET_CODE (p) != INSN || asm_noperands (PATTERN (p)) >= 0
+          || GET_CODE (PATTERN (p)) == ASM_INPUT
+          || volatile_insn_p (PATTERN (p)) || volatile_refs_p (PATTERN (p))
+          || GET_CODE (PATTERN (p)) == TRAP_IF || reg_set_p (base, p))
+        return 0;
+      if (reg_mentioned_p (stack_pointer_rtx, PATTERN (p)))
+        {
+          set = single_set (p);
+          if (set == 0)
+            return 0;
+          src = SET_SRC (set);
+          if (!allocated && !prologue_end && RTX_FRAME_RELATED_P (p)
+              && SET_DEST (set) == stack_pointer_rtx
+              && GET_CODE (src) == MINUS && XEXP (src, 0) == stack_pointer_rtx
+              && GET_CODE (XEXP (src, 1)) == CONST_INT
+              && INTVAL (XEXP (src, 1)) == current_frame_info.total_size)
+            {
+              allocated = 1;
+              allocation = p;
+            }
+          else if (!allocated || prologue_end
+                   || !mips_new_frame_gpr_save_p (p, SET_DEST (set)))
+            return 0;
+        }
+      if (p == save)
+        {
+          if (!allocated || prologue_end)
+            return 0;
+          saved = 1;
+        }
+    }
+  return (p == insn && allocated && allocation_boundary
+          && saved && prologue_end);
+}
