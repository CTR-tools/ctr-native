+/* Only a real compiler-generated GPR save at its computed new-frame home.
+   FRAME_RELATED alone is not a claim that arbitrary stack memory is private. */
+static int
+mips_new_frame_gpr_save_p (insn, mem)
+     rtx insn, mem;
+{
+  rtx set, addr, src;
+  int n, regno;
+  long offset;
+  if (GET_CODE (insn) != INSN || !RTX_FRAME_RELATED_P (insn)
+      || GET_CODE (mem) != MEM || GET_MODE (mem) != SImode
+      || MEM_VOLATILE_P (mem) || (set = single_set (insn)) == 0
+      || SET_DEST (set) != mem)
+    return 0;
+  src = SET_SRC (set);
+  if (GET_CODE (src) != REG || !GP_REG_P (REGNO (src)))
+    return 0;
+  regno = REGNO (src) - GP_REG_FIRST;
+  if (!BITSET_P (current_frame_info.mask, regno))
+    return 0;
+  offset = current_frame_info.gp_sp_offset;
+  for (n = GP_REG_NUM - 1; n > regno; --n)
+    if (BITSET_P (current_frame_info.mask, n))
+      offset -= UNITS_PER_WORD;
+  addr = XEXP (mem, 0);
+  return (offset >= 0 && offset + UNITS_PER_WORD <= current_frame_info.total_size
+          && GET_CODE (addr) == PLUS && XEXP (addr, 0) == stack_pointer_rtx
+          && GET_CODE (XEXP (addr, 1)) == CONST_INT
+          && INTVAL (XEXP (addr, 1)) == offset);
+}
