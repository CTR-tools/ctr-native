+int
+mips_adjacent_private_frame_sw_jump_p (branch, slot)
+     rtx branch, slot;
+{
+  rtx prev;
+  if (!mips_private_frame_sw_jump_p (branch, slot)) return 0;
+  prev = PREV_INSN (branch);
+  if (branch != get_insns () && (!prev || NEXT_INSN (prev) != branch)) return 0;
+  while (prev && GET_CODE (prev) == NOTE) prev = PREV_INSN (prev);
+  return prev == slot;
 }
 
