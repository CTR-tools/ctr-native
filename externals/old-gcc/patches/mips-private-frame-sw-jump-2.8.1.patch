+/* An adjacent SW crosses only a direct, unconditional local J.  The explicit
+   caller contract supplies mapped nonfaulting private stack RAM; precise
+   BD/EPC, asynchronous/interrupt and debugger observation are excluded. */
+static int
+mips_private_frame_sw_slot_p (slot)
+     rtx slot;
+{
+  rtx pat, mem, value, addr;
+  long offset = 0, low;
+  int n;
+  if (!slot || GET_CODE (slot) != INSN || INSN_DELETED_P (slot)
+      || recog_memoized (slot) != CODE_FOR_movsi_internal2
+      || get_attr_type (slot) != TYPE_STORE || get_attr_length (slot) != 1
+      || GET_CODE (PATTERN (slot)) != SET) return 0;
+  pat = PATTERN (slot); mem = SET_DEST (pat); value = SET_SRC (pat);
+  if (GET_CODE (mem) != MEM || GET_MODE (mem) != SImode
