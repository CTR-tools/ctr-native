+  if (addr != stack_pointer_rtx || offset % 4 || offset < low
+      || current_frame_info.var_size < 4
+      || offset > low + current_frame_info.var_size - 4) return 0;
+  if (value == const0_rtx) return 1;
+  if (GET_CODE (value) != REG || GET_MODE (value) != SImode) return 0;
+  n = REGNO (value);
+  return GP_REG_P (n) && n >= 2 && n < 26 && !fixed_regs[n] && !global_regs[n];
+}
