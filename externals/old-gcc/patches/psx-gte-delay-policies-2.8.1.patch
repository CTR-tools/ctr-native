+mips_cpu_lhu_gpr_p (x, mode)
+     rtx x;
+     enum machine_mode mode;
+{
+  int n;
+  if (GET_CODE (x) != REG || GET_MODE (x) != mode)
+    return 0;
+  n = REGNO (x);
+  return (GP_REG_P (n) && n >= 2 && n < 26
+          && !fixed_regs[n] && !global_regs[n]);
