+/* Literal one-word ALU/shift, bare return, or the named direct VXY0 load.
+   No other MEM or opaque ASM is a timing witness.
+   REG->REG is excluded: final_scan_insn can suppress a self move without
+   deleting its RTL.  Metadata and flow-only USE/CLOBBER never count.
+   reg_overlap_mentioned_p excludes write-only SET destinations, so a witness
+   must also pass reg_set_p to preserve the pending full-register value.  */
+static int
+mips_sxy2_gap_p (insn, dest)
+     rtx insn, dest;
+{
+  rtx pat, src, operand;
+  enum rtx_code code;
+  int i;
+  for (; insn; insn = NEXT_INSN (insn))
+    {
+      if (GET_CODE (insn) == NOTE || GET_CODE (insn) == CODE_LABEL)
+        continue;
+      if (GET_CODE (insn) == INSN
+          && (GET_CODE (PATTERN (insn)) == USE
+              || GET_CODE (PATTERN (insn)) == CLOBBER))
+        continue;
+      break;
+    }
+  if (!insn || (GET_CODE (insn) != INSN && GET_CODE (insn) != JUMP_INSN)
+      || INSN_DELETED_P (insn)
+      || GET_CODE (PATTERN (insn)) == SEQUENCE || recog_memoized (insn) < 0
+      || get_attr_length (insn) != 1 || reg_set_p (dest, insn))
+    return 0;
+  pat = PATTERN (insn);
+  if (GET_CODE (pat) == RETURN)
+    return REGNO (dest) != 31; /* The actual JR reads RA implicitly.  */
+  if (GET_CODE (insn) == INSN
+      && recog_memoized (insn) == CODE_FOR_psx_lwc2_vxy0
+      && GET_CODE (pat) == SET && GET_CODE (SET_DEST (pat)) == REG
+      && GET_MODE (SET_DEST (pat)) == SImode
+      && REGNO (SET_DEST (pat)) == GTE_VXY0_REGNUM
+      && get_attr_type (insn) == TYPE_LOAD
+      && mips_vxy0_memory_operand (SET_SRC (pat), SImode)
+      && !reg_overlap_mentioned_p (dest, SET_SRC (pat)))
+    return 1;
+  if (GET_CODE (insn) != INSN || GET_CODE (pat) != SET
+      || GET_CODE (SET_DEST (pat)) != REG || GET_MODE (SET_DEST (pat)) != SImode
+      || !GP_REG_P (REGNO (SET_DEST (pat))) || get_attr_type (insn) != TYPE_ARITH
+      || reg_overlap_mentioned_p (dest, pat))
+    return 0;
+  src = SET_SRC (pat);
+  code = GET_CODE (src);
+  if (code != AND && code != IOR && code != XOR && code != PLUS && code != MINUS
+      && code != ASHIFT && code != ASHIFTRT && code != LSHIFTRT)
+    return 0;
+  for (i = 0; i < 2; i++)
+    {
+      operand = XEXP (src, i);
+      if (GET_CODE (operand) != CONST_INT
+          && (GET_CODE (operand) != REG || GET_MODE (operand) != SImode
+              || !GP_REG_P (REGNO (operand))))
+        return 0;
+    }
+  return 1;
