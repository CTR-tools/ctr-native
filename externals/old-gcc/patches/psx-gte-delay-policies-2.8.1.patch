+static rtx
+mips_sxy2_slot_dest (insn)
+     rtx insn;
+{
+  rtx pat;
+  if (!insn || GET_CODE (insn) != INSN)
+    return 0;
+  pat = PATTERN (insn);
+  return (GET_CODE (pat) == SET && GET_CODE (SET_SRC (pat)) == REG
+          && REGNO (SET_SRC (pat)) == GTE_SXY2_REGNUM) ? SET_DEST (pat) : 0;
+}
+
+static int
+mips_sxy2_slot_branch_p (branch, slot)
+     rtx branch, slot;
+{
+  rtx dest = mips_sxy2_slot_dest (slot);
+  rtx pat, src, cond, target;
+  int regno;
+  if (!dest || INSN_DELETED_P (slot)
+      || GET_CODE (dest) != REG || GET_MODE (dest) != SImode
+      || GET_MODE (SET_SRC (PATTERN (slot))) != SImode)
+    return 0;
+  regno = REGNO (dest);
+  if (!GP_REG_P (regno) || regno < 2 || regno >= 26
+      || fixed_regs[regno] || global_regs[regno]
+      || recog_memoized (slot) < 0 || get_attr_type (slot) != TYPE_XFER
+      || get_attr_length (slot) != 1 || GET_CODE (branch) != JUMP_INSN
+      || INSN_DELETED_P (branch)
+      || INSN_ANNULLED_BRANCH_P (branch) || recog_memoized (branch) < 0
+      || get_attr_type (branch) != TYPE_BRANCH || get_attr_length (branch) != 1)
+    return 0;
+  pat = PATTERN (branch);
+  if (GET_CODE (pat) != SET || SET_DEST (pat) != pc_rtx
+      || GET_CODE (SET_SRC (pat)) != IF_THEN_ELSE || !JUMP_LABEL (branch))
+    return 0;
+  src = SET_SRC (pat);
+  cond = XEXP (src, 0);
+  target = XEXP (src, 1) == pc_rtx ? XEXP (src, 2) : XEXP (src, 1);
+  return ((GET_CODE (cond) == EQ || GET_CODE (cond) == NE)
+          && GET_MODE (cond) == SImode && GET_CODE (XEXP (cond, 0)) == REG
+          && GET_MODE (XEXP (cond, 0)) == SImode
+          && GP_REG_P (REGNO (XEXP (cond, 0)))
+          && XEXP (cond, 1) == const0_rtx
+          && (XEXP (src, 1) == pc_rtx || XEXP (src, 2) == pc_rtx)
+          && GET_CODE (target) == LABEL_REF
+          && XEXP (target, 0) == JUMP_LABEL (branch));
+}
