+/* Admit only a real main-chain branch's owned, unlabelled fallthrough head.
+   Stock eager DBR retains all opposite-path liveness/resource/trap tests.  */
+int
+mips_sxy2_delay_p (branch, slot)
+     rtx branch, slot;
+{
+  rtx next, prev;
+  if (!mips_sxy2_slot_branch_p (branch, slot))
+    return 0;
+  prev = PREV_INSN (branch);
+  if (branch != get_insns () && (!prev || NEXT_INSN (prev) != branch))
+    return 0;
+  for (next = NEXT_INSN (branch); next; next = NEXT_INSN (next))
+    if (GET_CODE (next) != NOTE
+        && !(GET_CODE (next) == INSN
+             && (GET_CODE (PATTERN (next)) == USE
+                 || GET_CODE (PATTERN (next)) == CLOBBER)))
+      break;
+  return (next == slot
+          && mips_sxy2_gap_p (NEXT_INSN (slot), SET_DEST (PATTERN (slot)))
+          && mips_sxy2_gap_p (JUMP_LABEL (branch), SET_DEST (PATTERN (slot))));
