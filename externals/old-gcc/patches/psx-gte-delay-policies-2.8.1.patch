+static int
+mips_cpu_lhu_address_p (mem, mode)
+     rtx mem;
+     enum machine_mode mode;
+{
+  rtx addr, offset;
+  HOST_WIDE_INT displacement;
+  if (GET_CODE (mem) != MEM || GET_MODE (mem) != mode)
+    return 0;
+  addr = XEXP (mem, 0);
+  if (GET_CODE (addr) != PLUS || GET_MODE (addr) != SImode
+      || !mips_cpu_lhu_base_p (XEXP (addr, 0)))
+    return 0;
+  offset = XEXP (addr, 1);
+  if (GET_CODE (offset) != CONST_INT)
+    return 0;
+  displacement = INTVAL (offset);
+  return (displacement >= -32768 && displacement <= 32767
+          && displacement % GET_MODE_SIZE (mode) == 0);
