+/* A volatile SI load from one CPU base and a literal signed displacement.
+   Unlike simple_memory_operand, this never accepts a symbolic/LO_SUM form.
+   Pseudos are allowed only before reload completes; the final gap check
+   consequently sees an actual CPU base register and one emitted word.  */
+int
+mips_vxy0_memory_operand (op, mode)
+     rtx op;
+     enum machine_mode mode;
+{
+  rtx addr;
+  if (mode != SImode || GET_CODE (op) != MEM || GET_MODE (op) != SImode
+      || !MEM_VOLATILE_P (op))
+    return 0;
+  addr = XEXP (op, 0);
+  if (GET_CODE (addr) == PLUS)
+    {
+      if (GET_CODE (XEXP (addr, 1)) != CONST_INT
+          || !SMALL_INT (XEXP (addr, 1)))
+        return 0;
+      addr = XEXP (addr, 0);
+    }
+  return (GET_CODE (addr) == REG && GET_MODE (addr) == Pmode
+          && (GP_REG_P (REGNO (addr))
+              || (!reload_completed && REGNO (addr) >= FIRST_PSEUDO_REGISTER)));
+}
