+/* Original-chain proofs are cached before queue links reuse NEXT_INSN.  */
+static char *continuation_constants;
+int
+sched_continuation_constant_p (insn, jump)
+     rtx insn, jump;
+{
+#ifdef HAVE_ATTR_length
+  rtx pat = PATTERN (insn), reg, cursor;
+  enum machine_mode mode;
+  if (GET_CODE (pat) != SET || GET_CODE (SET_DEST (pat)) != REG
+      || GET_CODE (SET_SRC (pat)) != CONST_INT)
+    return 0;
+  reg = SET_DEST (pat);
+  mode = GET_MODE (reg);
+  if (REGNO (reg) >= FIRST_PSEUDO_REGISTER || fixed_regs[REGNO (reg)]
+      || ! TEST_HARD_REG_BIT (reg_class_contents[(int) BASE_REG_CLASS], REGNO (reg))
+      || (mode != QImode && mode != HImode && mode != SImode)
+      || HARD_REGNO_NREGS (REGNO (reg), mode) != 1
+      || recog_memoized (insn) < 0 || insn_default_length (insn) != 1
+      || result_ready_cost (insn) != 1)
+    return 0;
+  for (cursor = NEXT_INSN (insn); cursor != jump; cursor = NEXT_INSN (cursor))
+    {
+      if (! cursor) return 0;
+      if (GET_CODE (cursor) == NOTE) continue;
+      if (GET_CODE (cursor) != INSN || GET_CODE (PATTERN (cursor)) != SET
+          || asm_noperands (PATTERN (cursor)) >= 0 || recog_memoized (cursor) < 0
+          || reg_set_p (reg, cursor))
+        return 0;
+    }
+  for (cursor = NEXT_INSN (JUMP_LABEL (jump)); cursor; cursor = NEXT_INSN (cursor))
+    {
+      if (GET_CODE (cursor) == NOTE || GET_CODE (cursor) == CODE_LABEL) continue;
+      if (GET_CODE (cursor) == INSN && GET_CODE (PATTERN (cursor)) == USE) continue;
+      if (GET_CODE (cursor) != INSN || GET_CODE (PATTERN (cursor)) != SET
+          || asm_noperands (PATTERN (cursor)) >= 0 || recog_memoized (cursor) < 0
+          || insn_default_length (cursor) <= 0 || reg_set_p (reg, cursor))
+        return 0;
+      if (reg_referenced_p (reg, PATTERN (cursor))) return 1;
+    }
+#endif
+  return 0;
+}
