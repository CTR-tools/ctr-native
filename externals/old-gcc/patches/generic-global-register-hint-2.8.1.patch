+/* Current declarations after ordinary optimization and LOCAL allocation.
+   Lost/dead declarations and already-LOCAL pseudos have no GLOBAL hint. */
+static void
+collect_global_register_hints (block)
+     tree block;
+{
+  tree decl, sub, attribute;
+  if (!block || TREE_CODE (block) != BLOCK)
+    return;
+  for (decl = BLOCK_VARS (block); decl; decl = TREE_CHAIN (decl))
+    if (TREE_CODE (decl) == VAR_DECL
+        && (attribute = lookup_attribute ("global_register_hint",
+                                          DECL_MACHINE_ATTRIBUTES (decl))))
+      {
+        rtx reg = DECL_RTL (decl);
+        int pseudo, allocno, hint;
+        if (TREE_ADDRESSABLE (decl)
+            || (reg && GET_CODE (reg) == REG
+                && REGNO (reg) < FIRST_PSEUDO_REGISTER))
+          {
+            error ("global_register_hint cannot apply to address-exposed or hard-asm variables");
+            continue;
+          }
+        if (!reg || GET_CODE (reg) != REG)
+          continue;
+        pseudo = REGNO (reg);
+        if (pseudo >= max_regno || !REG_N_REFS (pseudo)
+            || (allocno = reg_allocno[pseudo]) < 0)
+          continue;
+        hint = global_register_hint_value (decl, TREE_VALUE (attribute));
+        if (!hint)
+          continue;
+        if (decl_hint_dump)
+          fprintf (decl_hint_dump, ";; Global hint pseudo %d allocno %d register %d.\n", pseudo, allocno, hint - 1);
+        if (allocno_decl_hints[allocno] < 0)
+          continue;
+        if (allocno_decl_hints[allocno]
+            && allocno_decl_hints[allocno] != hint)
+          {
+            allocno_decl_hints[allocno] = -1;
+            if (decl_hint_dump)
+              fprintf (decl_hint_dump, ";; Global hint allocno %d canceled: conflicting declarations.\n", allocno);
+          }
+        else
+          allocno_decl_hints[allocno] = hint;
+      }
+  for (sub = BLOCK_SUBBLOCKS (block); sub; sub = TREE_CHAIN (sub))
+    collect_global_register_hints (sub);
+}
+
+static int
+hinted_allocno_compare (p1, p2)
+     const GENERIC_PTR p1;
+     const GENERIC_PTR p2;
+{
+  int a = *(int *) p1, b = *(int *) p2;
+  int ah = allocno_decl_hints && allocno_decl_hints[a] > 0;
+  int bh = allocno_decl_hints && allocno_decl_hints[b] > 0;
+  if (ah != bh)
+    return bh - ah;
+  return allocno_compare (p1, p2);
+}
+
+/* USED is built by ordinary allocation, including retry losers. A request
+   for a call-clobbered color does not itself induce caller saves. */
+static int
+global_hint_reg (allocno, used)
+     int allocno;
+     HARD_REG_SET used;
+{
+  int regno;
+  enum machine_mode mode = PSEUDO_REGNO_MODE (allocno_reg[allocno]);
+  if (!allocno_decl_hints || allocno_decl_hints[allocno] <= 0
+      || allocno_size[allocno] != 1)
+    return -1;
+  regno = allocno_decl_hints[allocno] - 1;
+  if (fixed_regs[regno] || global_regs[regno]
+      || (allocno_calls_crossed[allocno] && call_used_regs[regno])
+      || TEST_HARD_REG_BIT (used, regno)
+      || !HARD_REGNO_MODE_OK (regno, mode)
+      || HARD_REGNO_NREGS (regno, mode) != 1)
+    return -1;
+  return regno;
 }
 
