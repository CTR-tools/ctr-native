+/* An explicit nonfaulting-MMIO contract, not general volatile speculation.
+   One SH immediately before a frameless leaf return executes exactly once,
+   after every preceding volatile access.  Faulting addresses, exception
+   BD/EPC equivalence and interrupt observation are outside this opt-in.  */
+static int
+mips_nonfaulting_sh_slot_p (slot)
+     rtx slot;
+{
+  rtx pat, mem, value, addr;
+  int n;
+  if (!slot || GET_CODE (slot) != INSN || INSN_DELETED_P (slot)
+      || recog_memoized (slot) != CODE_FOR_movhi_internal2
+      || get_attr_type (slot) != TYPE_STORE || get_attr_length (slot) != 1)
+    return 0;
+  pat = PATTERN (slot);
+  if (GET_CODE (pat) != SET)
+    return 0;
+  mem = SET_DEST (pat);
+  value = SET_SRC (pat);
+  if (GET_CODE (mem) != MEM || GET_MODE (mem) != HImode
+      || !MEM_VOLATILE_P (mem) || RTX_UNCHANGING_P (mem))
+    return 0;
+  addr = XEXP (mem, 0);
+  if (!(mips_cpu_lhu_base_p (addr)
+        || mips_cpu_lhu_address_p (mem, HImode)))
+    return 0;
+  if (value == const0_rtx)
+    return 1;
+  if (GET_CODE (value) == SUBREG && GET_MODE (value) == HImode
+      && SUBREG_WORD (value) == 0 && GET_CODE (SUBREG_REG (value)) == REG
+      && GET_MODE (SUBREG_REG (value)) == SImode)
+    value = SUBREG_REG (value);
+  if (GET_CODE (value) != REG
+      || (GET_MODE (value) != HImode && GET_MODE (value) != SImode))
+    return 0;
+  n = REGNO (value);
+  return GP_REG_P (n) && n >= 2 && n < 26;
+}
