+static int
+mips_nonfaulting_sh_return_p (ret, slot)
+     rtx ret, slot;
+{
+  return (TARGET_NONFAULTING_SH_RETURN && reload_completed
+          && mips_can_use_return_insn ()
+          && mips_nonfaulting_sh_slot_p (slot)
+          && ret && GET_CODE (ret) == JUMP_INSN && !INSN_DELETED_P (ret)
+          && !INSN_ANNULLED_BRANCH_P (ret)
+          && GET_CODE (PATTERN (ret)) == RETURN
+          && recog_memoized (ret) == CODE_FOR_return
+          && get_attr_type (ret) == TYPE_JUMP && get_attr_length (ret) == 1);
+}
+
+int
+mips_adjacent_nonfaulting_sh_return_p (ret, slot)
+     rtx ret, slot;
+{
+  rtx prev;
+  if (!mips_nonfaulting_sh_return_p (ret, slot))
+    return 0;
+  prev = PREV_INSN (ret);
+  if (ret != get_insns () && (!prev || NEXT_INSN (prev) != ret))
+    return 0;
+  while (prev && GET_CODE (prev) == NOTE)
+    prev = PREV_INSN (prev);
+  return prev == slot;
+}
