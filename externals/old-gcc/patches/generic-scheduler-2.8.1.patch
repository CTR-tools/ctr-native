+/* Join only the dying matching input of an otherwise untouched empty asm.  */
+static rtx
+combine_empty_asm (body, insn, number)
+     rtx body, insn;
+     int number;
+{
+  rtx a, regs[3], note;
+  int i, match = -1, dep = -1, q;
+
+  if (GET_CODE (body) != SET)
+    return NULL_RTX;
+  a = SET_SRC (body);
+  if (GET_CODE (a) != ASM_OPERANDS || GET_MODE (a) != VOIDmode
+      || MEM_VOLATILE_P (a) || ASM_OPERANDS_TEMPLATE (a)[0] != 0
+      || strcmp (ASM_OPERANDS_OUTPUT_CONSTRAINT (a), "=r")
+      || ASM_OPERANDS_OUTPUT_IDX (a) != 0
+      || ASM_OPERANDS_INPUT_VEC (a) == 0
+      || ASM_OPERANDS_INPUT_CONSTRAINT_VEC (a) == 0
+      || ASM_OPERANDS_INPUT_LENGTH (a) != 2
+      || XVECLEN (a, 4) != 2)
+    return NULL_RTX;
+  regs[0] = SET_DEST (body);
+  for (i = 0; i < 2; i++)
+    {
+      char *c = ASM_OPERANDS_INPUT_CONSTRAINT (a, i);
+      regs[i + 1] = ASM_OPERANDS_INPUT (a, i);
+      if (ASM_OPERANDS_INPUT_MODE (a, i) != SImode)
+        return NULL_RTX;
+      if (! strcmp (c, "0") && match < 0)
+        match = i + 1;
+      else if (! strcmp (c, "r") && dep < 0)
+        dep = i + 1;
+      else
+        return NULL_RTX;
+    }
+  if (match < 0 || dep < 0)
+    return NULL_RTX;
+  for (i = 0; i < 3; i++)
+    if (GET_CODE (regs[i]) != REG || GET_MODE (regs[i]) != SImode
+        || REGNO (regs[i]) < FIRST_PSEUDO_REGISTER
+        || REG_SIZE (regs[i]) != 1
+        || reg_preferred_class (REGNO (regs[i])) != GENERAL_REGS
+        || reg_alternate_class (REGNO (regs[i])) != NO_REGS
+        || REG_N_CALLS_CROSSED (REGNO (regs[i])) != 0)
+      return NULL_RTX;
+  q = reg_qty[REGNO (regs[match])];
+  if (REGNO (regs[0]) == REGNO (regs[match])
+      || REGNO (regs[0]) == REGNO (regs[dep])
+      || REGNO (regs[match]) == REGNO (regs[dep])
+      || reg_qty[REGNO (regs[0])] != -2 || q < 0
+      || reg_qty[REGNO (regs[dep])] == q
+      || qty_size[q] != 1 || qty_mode[q] != SImode
+      || qty_min_class[q] != GENERAL_REGS || qty_alternate_class[q] != NO_REGS
+      || qty_n_calls_crossed[q] != 0
+      || (note = find_regno_note (insn, REG_DEAD,
+                                REGNO (regs[match]))) == 0
+      || GET_CODE (XEXP (note, 0)) != REG
+      || GET_MODE (XEXP (note, 0)) != SImode)
+    return NULL_RTX;
+  if (! combine_regs (regs[match], regs[0], 1, number, insn, 0))
+    return NULL_RTX;
+  return regs[match];
+}
