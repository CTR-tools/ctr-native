+/* Empty templates emit no instruction.  Keep every dependency and reject
+   groups or uncertain real operand latency; never infer readiness from notes. */
+static int
+sched_zero_empty_issue_p (insn)
+     rtx insn;
+{
+  rtx pat, next, link, pred;
+  if (! reload_completed || ! flag_sched_zero_empty_issue_after_reload
+      || GET_CODE (insn) != INSN || SCHED_GROUP_P (insn)
+      || RTX_FRAME_RELATED_P (insn))
+    return 0;
+  next = next_nonnote_insn (insn);
+  if (next && GET_CODE (next) != CODE_LABEL && SCHED_GROUP_P (next))
+    return 0;
+  pat = PATTERN (insn);
+  if ((GET_CODE (pat) == PARALLEL && XVECLEN (pat, 0) == 0)
+      || asm_noperands (pat) < 0
+      || *decode_asm_operands (pat, NULL_PTR, NULL_PTR, NULL_PTR, NULL_PTR))
+    return 0;
+  for (link = LOG_LINKS (insn); link; link = XEXP (link, 1))
+    {
+      if (REG_NOTE_KIND (link) != 0)
+        continue;
+      pred = XEXP (link, 0);
+      if (GET_CODE (pred) != INSN || SCHED_GROUP_P (pred)
+          || RTX_FRAME_RELATED_P (pred) || recog_memoized (pred) < 0)
+        return 0;
+      next = next_nonnote_insn (pred);
+      if (next && GET_CODE (next) != CODE_LABEL && SCHED_GROUP_P (next))
+        return 0;
+      /* Old virtual-result links can survive reload without defining any
+         current asm operand.  Retain them, including their stock cost. */
+      if (result_ready_cost (pred) > 1 && modified_in_p (pat, pred))
+        return 0;
+    }
+  return 1;
+}
