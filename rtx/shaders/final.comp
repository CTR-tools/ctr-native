#version 460
// albedo x filtered lighting -> exposure, soft shoulder, sRGB, then the
// semi-transparent layer (water, glass, glows) blended the PS1 way -> display
// colour at the traced size (bloom.comp adds the glow, taa.comp resolves it
// onto the output: RGBA8 rows top-down). Alpha 0 where nothing was hit: the GL
// sky layer shows.

#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 8, std430) readonly buffer AlbedoBuf { vec4 albedoIn[]; };
layout(set = 0, binding = 9, std430) readonly buffer GeoCur { vec4 geo[]; };
layout(set = 0, binding = 12, std430) readonly buffer HistCur { vec4 hist[]; };
layout(set = 0, binding = 13, std430) readonly buffer Filtered { vec4 filtered[]; };
layout(set = 0, binding = 14, std430) writeonly buffer Glow { vec4 glowOut[]; }; // linear, for bloom.comp
layout(set = 0, binding = 19, std430) readonly buffer LayerBuf { vec4 layerIn[]; };
layout(set = 0, binding = 36, std430) writeonly buffer Disp { vec4 dispOut[]; }; // display colour, alpha
layout(set = 0, binding = 41, std430) readonly buffer Spec { vec4 specIn[]; };     // specular light (trace.comp)
layout(set = 0, binding = 43, std430) readonly buffer Fog { vec4 fogIn[]; };       // air's light, a: 2 x frames + transmittance

vec3 shoulder(vec3 x)
{
	// identity up to 0.8, then rolls off towards ~1.6
	vec3 over = max(x - 0.8, 0.0);
	return min(x, vec3(0.8)) + over / (1.0 + over / 0.8);
}

void main()
{
	uvec2 px = gl_GlobalInvocationID.xy;
	if ((px.x >= F.size.x) || (px.y >= F.size.y))
	{
		return;
	}
	uint idx = px.y * F.size.x + px.x;
	vec4 a = albedoIn[idx];
	vec4 layer = layerIn[idx];
	uint view = F.size.w;
	float exposure = F.sunColor.w;

	vec3 color = vec3(0.0);
	float alpha = 0.0;
	vec3 glow = vec3(0.0);
	if (a.a != 0.0)
	{
		vec3 light = filtered[idx].rgb;
		if (view == 1u)
		{
			color = linearToSrgb(a.rgb);
		}
		else if (view == 2u)
		{
			color = geo[idx].xyz * 0.5 + 0.5;
		}
		else if (view == 3u)
		{
			color = linearToSrgb(shoulder(light * exposure * 0.5));
		}
		else if (view == 4u)
		{
			color = linearToSrgb(shoulder(hist[idx].rgb * exposure * 0.5));
		}
		else if (view >= 6u)
		{
			color = vec3(light.r);
		}
		else if (view == 5u)
		{
			// texture layer coverage: red where the PS1's polygon wasn't found
			color = (fract(a.a) > 0.1) ? vec3(1.0, 0.0, 0.0) : linearToSrgb(a.rgb);
		}
		else if (F.extra.z == 0u)
		{
			color = linearToSrgb(clamp(a.rgb * light * exposure, 0.0, 1.0)); // hybrid: PS1 colours, PS1 clamp
		}
		else
		{
			vec3 hdr = (a.rgb * light + specIn[idx].rgb) * exposure;
			vec4 fog = fogIn[idx];
			float T = fog.a - 2.0 * floor(fog.a / 2.0);
			T = (fog.a >= 2.0) ? T : 1.0;
			hdr = hdr * T + fog.rgb * exposure;
			color = linearToSrgb(shoulder(hdr));
			// glowing surfaces bloom; so does light far over white
			glow = (a.a > 2.5) ? hdr * 0.5 : max(hdr - vec3(1.2), vec3(0.0)) * 0.5;
		}
		alpha = 1.0;
	}

	if ((layer.a > 0.0) && (view == 0u))
	{
		uint blend = uint(floor(layer.a));
		float k = fract(layer.a);
		if (alpha > 0.0)
		{
			if (blend == 0u)
			{
				color = mix(color, layer.rgb, k);
			}
			else if (blend == 1u)
			{
				color += layer.rgb;
				glow += srgbToLinear(layer.rgb) * 0.4; // additive glows bloom
			}
			else if (blend == 2u)
			{
				color -= layer.rgb;
			}
			else
			{
				color += 0.25 * layer.rgb;
			}
		}
		else
		{
			// over the GL sky: approximate with alpha
			color = layer.rgb;
			alpha = (blend == 0u) ? k : clamp(luma(layer.rgb), 0.0, 1.0);
		}
	}

	glowOut[idx] = vec4((view == 0u) && (F.extra.z != 0u) ? glow : vec3(0.0), 0.0);
	dispOut[idx] = vec4(clamp(color, 0.0, 1.0), clamp(alpha, 0.0, 1.0));
}
