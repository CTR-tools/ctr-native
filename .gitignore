*.exe
*.o
*.gch
*.a
*.obj
*.pdb
*.ilk
*.d
*.depend
*.map
compile_commands.json

# Language and editor state.
.venv/
__pycache__/
*.py[cod]
.vs/
.idea/
*.swp
*~
